# Runtime defaults
NODE_ENV=production
PORT=3000

# Use a dedicated MySQL/TiDB staging database; never point this at production.
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/island_handyman_staging

# Native Island Handyman authentication
# OWNER_EMAIL is the verified email allowed to establish the first owner account.
OWNER_EMAIL=
# REQUIRED in staging: use the temporary preview origin supplied by your host.
# The server has a production-domain fallback if this is omitted.
PUBLIC_APP_URL=https://your-staging-host.example

# Optional for testing account setup/reset email; use a staging-only key and sender.
RESEND_API_KEY=
EMAIL_FROM="Island Handyman Staging <noreply@your-verified-sender-domain>"

# Optional server-side Manus Forge adapter settings; these do not make the app portable.
# BUILT_IN_FORGE_API_URL=
# BUILT_IN_FORGE_API_KEY=
# Optional browser-facing Forge settings. VITE_ values are exposed in the built client.
# VITE_FRONTEND_FORGE_API_URL=
# VITE_FRONTEND_FORGE_API_KEY=
# Optional analytics.
# MANUS_ANALYTICS_ENDPOINT=
# MANUS_ANALYTICS_WEBSITE_ID=
# VITE_ANALYTICS_ENDPOINT=
# VITE_ANALYTICS_WEBSITE_ID=
