# Runtime
NODE_ENV=production
PORT=3000

# Database — required for an independent deployment
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/island_handyman

# Native on-domain password authentication
# Set to the owner’s verified email before owner account setup is requested.
OWNER_EMAIL=
# Canonical public origin used in password links; do not derive from request Host.
PUBLIC_APP_URL=https://islandhandyman.vip

# Private project files and existing Manus service adapters
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Browser map/data adapter (only needed for features that use the map)
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=

# Transactional email for password setup and password recovery
# Verify the sender domain with Resend before using it.
RESEND_API_KEY=
EMAIL_FROM="Island Handyman <noreply@islandhandyman.vip>"

# Optional analytics placeholders used by the existing HTML shell
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
