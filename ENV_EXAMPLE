# Runtime
NODE_ENV=production
PORT=3000

# Database — required
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/island_handyman

# Session/auth — required by the current Manus auth adapter
JWT_SECRET=replace-with-a-long-random-secret
VITE_APP_ID=replace-with-oauth-app-id
OAUTH_SERVER_URL=https://api.manus.im
VITE_OAUTH_PORTAL_URL=https://manus.im
OWNER_OPEN_ID=replace-with-owner-open-id
OWNER_NAME=Island Handyman Owner

# Current private file storage / Forge adapter
# Required by the existing Manus storage proxy unless you replace server/storage.ts.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Browser map/data adapter (only needed for features that use the map)
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=

# Optional transactional email adapter
RESEND_API_KEY=
EMAIL_FROM=Island Handyman <noreply@example.com>
OWNER_EMAIL=owner@example.com

# Optional analytics placeholders used by the existing HTML shell
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
